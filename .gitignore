/vendor/
/storage/database/*.sqlite
/storage/cache/
/storage/suite/
!public/downloads/.gitkeep
build-cache/

# Desktop build artifacts
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Native probe build artifacts
agent/pclab_probe/PcLabHwMon/bin/
agent/pclab_probe/PcLabHwMon/obj/
agent/pclab_probe/PcLabHwMon.exe
agent/pclab_probe/PcLabVkBench/bin/
agent/pclab_probe/PcLabVkBench/obj/
agent/pclab_probe/PcLabVkBench.exe

# Rust probe core build artifacts
agent/pclab_core/target/

# Downloaded binaries
public/downloads/*.zip
public/downloads/*.tar.gz
public/downloads/*.exe
public/downloads/*.run
public/downloads/*.AppImage
public/downloads/*.msi

# Knowledge graph (regenerable via `graphify update .`)
graphify-out/

# Secrets, credentials, API keys — never commit
.env
.env.local
.env.production
.env.*.local
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account*.json
**/secrets/
**/.secrets/
storage/settings/local.json
storage/settings/sensor_deck.json

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs
*.log

# Root E2E / Node (dev-only; not shipped in desktop bundle)
/node_modules/
/playwright-report/
/test-results/

# Misc
temp.md
/internal/
storage/test-lab-jobs-*.sqlite

# Tauri staged lab payload (built by scripts/stage-desktop-payload.*)
desktop/src-tauri/resources/lab/**
!desktop/src-tauri/resources/lab/.gitignore
!desktop/src-tauri/resources/lab/.gitkeep
